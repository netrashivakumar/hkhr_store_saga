# Copy this file to .env and fill in real values. Never commit .env.
REDIS_URL=rediss://default:PASSWORD@host.upstash.io:6379
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: separate databases per service (fall back to DATABASE_URL if unset)
# ORDERS_DATABASE_URL=
# INVENTORY_DATABASE_URL=
# PAYMENTS_DATABASE_URL=

# Codespaces only (browser-reachable forwarded URLs):
# ORDER_API_URL=https://<codespace-name>-5001.<forwarding-domain>
# ALLOWED_ORIGINS=https://<codespace-name>-5000.<forwarding-domain>
